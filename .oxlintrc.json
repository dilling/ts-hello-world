{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "react", "jsx-a11y", "import", "promise", "vitest"],
  "jsPlugins": ["@tanstack/eslint-plugin-query", "@tanstack/eslint-plugin-router"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "drizzle",
    "src/web/routeTree.gen.ts",
    "node_modules",
    "test/fixtures",
    ".claude"
  ],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-console": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "jsx-a11y/heading-has-content": "off",
    "@tanstack/query/exhaustive-deps": "error",
    "@tanstack/query/no-rest-destructuring": "error",
    "@tanstack/query/stable-query-client": "error",
    "@tanstack/query/no-unstable-deps": "error",
    "@tanstack/router/create-route-property-order": "error"
  },
  "overrides": [
    {
      "files": ["src/server/db/migrate.ts", "src/server/db/seed.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "test/**"],
      "rules": {
        "no-console": "off",
        "vitest/require-to-throw-message": "off",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["**/*.db.test.ts", "test/db/setup.ts"],
      "rules": {
        "vitest/no-standalone-expect": "off",
        "no-empty-pattern": "off"
      }
    }
  ]
}
